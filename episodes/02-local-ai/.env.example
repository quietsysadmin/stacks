# Copy to .env, then fill in WEBUI_SECRET_KEY (README, step 3). .env is never committed.

# Signs Open WebUI's login sessions. Generate it, don't type it:
#   sed -i "s/^WEBUI_SECRET_KEY=.*/WEBUI_SECRET_KEY=$(openssl rand -hex 32)/" .env
WEBUI_SECRET_KEY=

# How much conversation a model keeps in mind, in tokens. Ollama's default is 4096.
# More context needs more video memory: after raising it, check `ollama ps` still says 100% GPU.
#OLLAMA_CONTEXT_LENGTH=4096
