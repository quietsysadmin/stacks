# /etc/restic.env, root:root, mode 600. No quotes around values:
# systemd's EnvironmentFile and `set -a; . /etc/restic.env` both read this file.
#
# Any S3-compatible storage works. Never on the server you're backing up.
#   Google Cloud Storage: s3:https://storage.googleapis.com/<bucket>/<host>
#   Backblaze B2:         s3:https://s3.<region>.backblazeb2.com/<bucket>/<host>
#   Cloudflare R2:        s3:https://<account-id>.r2.cloudflarestorage.com/<bucket>/<host>
RESTIC_REPOSITORY=s3:https://storage.googleapis.com/your-bucket/your-host
RESTIC_PASSWORD_FILE=/etc/restic.password

# A key allowed on this one bucket and nothing else.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
