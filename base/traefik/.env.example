# Copy to .env and fill in. .env is never committed (see base/.gitignore).

# Let's Encrypt account email. Not a secret.
ACME_EMAIL=you@example.com

# whoami answers on whoami.$DOMAIN. Point that name (or *.$DOMAIN) at this server first.
DOMAIN=example.com

# Rehearse against Let's Encrypt staging: untrusted certificates, generous rate limits.
# For the real thing, comment this out again and delete letsencrypt/acme.json.
#ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
